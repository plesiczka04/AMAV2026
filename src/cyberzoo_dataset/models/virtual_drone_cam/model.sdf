<?xml version="1.0"?>
<sdf version="1.6">
  <model name="virtual_drone_cam">
    <!-- Keep the model dynamic but disable gravity so it doesn't fall -->
    <static>false</static>
    <pose>0 0 4 0 0 0</pose>

    <link name="base_link">
      <!-- Disable gravity so the camera doesn't fall out of the sky -->
      <gravity>0</gravity>
      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.001</ixx>
          <iyy>0.001</iyy>
          <izz>0.001</izz>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <visual name="visual">
        <geometry>
          <box>
            <size>0.1 0.1 0.05</size>
          </box>
        </geometry>
        <material>
          <diffuse>0.1 0.1 0.8 1</diffuse>
          <ambient>0.1 0.1 0.8 1</ambient>
        </material>
      </visual>

        <sensor name="front_camera" type="camera">
        <pose>0.06 0 0 0 0 0</pose>      
        <always_on>true</always_on>
        <update_rate>30</update_rate>
        <camera>
          <horizontal_fov>1.45</horizontal_fov>
          <image>
            <width>520</width>
            <height>240</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <near>0.05</near>
            <far>100</far>
          </clip>
          <distortion>
            <k1>-0.25</k1>
            <k2>0.12</k2>
            <k3>0.0</k3>
            <p1>0.0</p1>
            <p2>0.0</p2>
            <center>0.59 0.5</center>
          </distortion>
        </camera> 
        <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
          <ros>
            <namespace>/</namespace>
            <remapping>image_raw:=front_camera/image_raw</remapping>
            <remapping>camera_info:=front_camera/camera_info</remapping>
          </ros>
          <camera_name>front_camera</camera_name>
          <frame_name>base_link</frame_name>
        </plugin>
      </sensor>
    </link>
  </model>
</sdf>

